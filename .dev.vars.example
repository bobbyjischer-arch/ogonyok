# Локальные секреты для `wrangler dev`. Скопировать в .dev.vars и заполнить.
# В продакшене задаются через `npm run secrets`, в репозиторий не попадают.
#
# Этот же файл читают оба окружения: `wrangler dev --env curated` берёт
# .dev.vars.curated, если он есть, и .dev.vars, если нет.

# Токен от @BotFather. Для локальных прогонов сойдёт и заглушка:
# запросы к Bot API просто не пройдут, а база и API работать будут.
BOT_TOKEN=123456789:LOCAL-TEST-TOKEN-NOT-REAL

# Любая случайная строка. Ею подписан вебхук и закрыт маршрут /setup.
WEBHOOK_SECRET=localdevsecret
